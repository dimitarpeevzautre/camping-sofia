rules_version = '2';
// The leaderboard of camping-sofia.com. The game page talks to Firestore directly, with no sign-in, so these
// rules are the only gate: anyone may read the top of the list, and anyone may add one well-formed score.
// Nothing can be changed or deleted from outside.
service cloud.firestore {
  match /databases/{database}/documents {
    match /scores/{id} {
      allow get: if true;
      allow list: if request.query.limit <= 50;
      allow create: if request.resource.data.keys().hasOnly(['name', 'score', 'parked', 'time', 'week', 'at'])
        && request.resource.data.keys().hasAll(['name', 'score', 'parked', 'time', 'week', 'at'])
        && request.resource.data.name is string
        && request.resource.data.name.matches('^[A-Za-z0-9Ѐ-ӿ _.-]{1,16}$')
        && request.resource.data.score is int && request.resource.data.score > 0 && request.resource.data.score <= 300000
        && request.resource.data.parked is int && request.resource.data.parked >= 0 && request.resource.data.parked <= 2000
        && request.resource.data.score <= request.resource.data.parked * 2500 + 5000
        && request.resource.data.time is int && request.resource.data.time >= 0 && request.resource.data.time <= 86400
        && request.resource.data.week is string && request.resource.data.week.matches('^[0-9]{4}-W[0-9]{2}$')
        && request.resource.data.at == request.time;
      allow update, delete: if false;
    }
  }
}
